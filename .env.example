# 1.13.9: keep the real file OUTSIDE the web folder: <domain>/private/.env (next to httpdocs), permissions 600,
# or point ENV_FILE at another path. Variables set in the Plesk panel win over this file. Restart the app after a change.
# Put quotes around any value that contains a # character. Never put a .env inside /httpdocs. Never commit it.
# Copy to .env and fill in.
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=owen
DB_PASS=change-me

# REQUIRED in production. Generate with:  npm run secret
# (Changing it signs everyone out once.)
JWT_SECRET=

# REQUIRED in production: the exact address(es) people use to open the site, comma-separated.
# Leave empty only for local development (empty = any website may call the API).
CORS_ORIGIN=https://portal.example.com

# Behind a reverse proxy / HTTPS host: number of proxy hops (usually 1) so rate limits see real visitor IPs.
# TRUST_PROXY=1   (set this on IONOS/Plesk: without it all visitors share one address in the rate limits)

# Refuse to start (instead of only warning) when JWT_SECRET is missing/short or CORS_ORIGIN is empty in production.
# STRICT_SECURITY=on

# Optional: change or disable rate limits (see middleware/rateLimits.js)
# RATE_LIMIT_SIGNIN_MAX=10
# RATE_LIMIT_SIGNUP_MAX=10
# RATE_LIMIT_MFA_MAX=15
# RATE_LIMIT_BORROW_MAX=30
# RATE_LIMIT_API_MAX=1200
# RATE_LIMIT=off

# Optional: other settings are documented in README.md -> Configuration
# NODE_ENV=production
# FORCE_HTTPS=on
# MAINTENANCE_REBUILD_ENABLED=true

# Meetings: reports and logos are kept in <PDF_DIR>/<user_id>/ (README 1.13.5). Optional; the default is a
# folder named "pdf" in the folder above the app, outside the web root.
# PDF_DIR=/var/www/vhosts/owen-enterprises.net/pdf

# BG Tracker "What I ate" (README 1.13.6): the food lookup is ON only when both are set. Set them as panel variables
# on IONOS (never a .env inside /httpdocs). fatsecret only gives tokens to the server IPs registered on the key.
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# RATE_LIMIT_FOODS_MAX=40

# Two-step sign-in (README 1.13.7). MFA_KEY encrypts authenticator secrets and phone numbers: long random value, set ONCE.
# MFA_KEY=
# Optional Redis for one-time-code claims, lockouts and the per-IP failed-attempt limit (unset = in memory):
# REDIS_URL=redis://127.0.0.1:6379
# MFA_MAX_ATTEMPTS=5
# MFA_LOCK_MINUTES=15
# RATE_LIMIT_MFA_VERIFY_MAX=20
